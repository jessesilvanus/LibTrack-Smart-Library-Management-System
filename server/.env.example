# ==============================================================================
# LibTrack — Smart Library Management System Environment Configuration
# ==============================================================================

# Core Application Settings
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/libtrack

# Application URL (used in email template call-to-actions)
APP_BASE_URL=http://localhost:5173

# ==============================================================================
# Email Notification Settings (Nodemailer)
# ==============================================================================
# If EMAIL_HOST and EMAIL_USER are left blank, LibTrack will safely operate in
# "Mock/Test Transport" mode, logging all generated reminders to the MongoDB
# notifications collection without attempting external network calls.

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false

# SMTP Authentication (NEVER commit real credentials to version control)
EMAIL_USER=
EMAIL_PASSWORD=

# Sender display name and address
EMAIL_FROM="LibTrack Central Library <notifications@libtrack.edu>"

# ==============================================================================
# Automated Reminder Schedule & Rules
# ==============================================================================
ENABLE_EMAIL_CRON=true
REMINDER_CRON_SCHEDULE="0 8 * * *"
REMINDER_DAYS_BEFORE_DUE=3
OVERDUE_REPEAT_INTERVAL_DAYS=7

# ==============================================================================
# Administrative Security & Guard
# ==============================================================================
ADMIN_API_KEY=libtrack-admin-secret-2024

# ==============================================================================
# Bulk CSV Import & Big Data Batch Processing
# ==============================================================================
# Maximum CSV upload file size in bytes (Default: 10485760 = 10 MB)
MAX_CSV_UPLOAD_BYTES=10485760

# Maximum permitted rows per single import file (Default: 5000)
MAX_CSV_ROWS=5000

# Batch chunk size for atomic database processing (Default: 50)
IMPORT_BATCH_SIZE=50
