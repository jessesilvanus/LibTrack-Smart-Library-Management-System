{
  "name": "libtrack-server",
  "version": "1.0.0",
  "description": "LibTrack Backend API — College Library Management System",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:memory": "tsx src/scripts/dev-memory.ts",
    "seed": "tsx src/scripts/seed.ts",
    "test": "tsx src/tests/workflow-integration.test.ts && tsx src/tests/notifications.test.ts && tsx src/tests/bulk-import.test.ts && tsx src/tests/analytics.test.ts",
    "test:workflows": "tsx src/tests/workflow-integration.test.ts",
    "test:notifications": "tsx src/tests/notifications.test.ts",
    "test:imports": "tsx src/tests/bulk-import.test.ts",
    "test:analytics": "tsx src/tests/analytics.test.ts"
  },
  "keywords": [
    "library",
    "management",
    "express",
    "typescript",
    "mongoose"
  ],
  "author": "LibTrack Team",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "mongodb-memory-server": "^11.3.0",
    "mongoose": "^8.7.0",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.16.10",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
